PORT=3000
# Public https URL Twilio can reach (e.g. your ngrok URL), no trailing slash
PUBLIC_URL=https://waffle-yoga-golf.ngrok-free.dev

# Twilio console > Account Info. The auth token also enables webhook signature validation;
# the account SID is needed to transfer and hang up calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Postgres, where the businesses are stored. This matches the database in docker-compose.yml
# (start it with: docker compose up -d db). Inside Docker the server uses its own setting.
DATABASE_URL=postgres://receptionist:receptionist@localhost:5433/receptionist

# API for the web apps (npm run api), used by the admin site in web/. Only reachable from this computer.
# API_PORT=3001
# Admin site port in Docker (docker compose up): http://localhost:3001
# WEB_PORT=3001
# Optional password for the admin site (the browser asks for it; any username works)
# ADMIN_PASSWORD=

# Owner sign-in (Better Auth). BETTER_AUTH_URL is the address owners open the web app on: the Vite
# dev server here (docker-compose.yml sets its own). BETTER_AUTH_SECRET signs session cookies;
# make one with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=
# Google sign-in: Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID
# (Web application). Authorized redirect URIs: http://localhost:5173/api/auth/callback/google
# (and http://localhost:3001/api/auth/callback/google for Docker).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Buying Twilio numbers for businesses once their plan is paid: dry-run (the default, records what
# would be bought without calling Twilio), live (buys them from your Twilio balance) or off.
# TWILIO_BUY_NUMBERS=dry-run

# Billing (Stripe). STRIPE_SECRET_KEY: Stripe Dashboard (test mode) > Developers > API keys. Then run
# npm run stripe:setup. STRIPE_WEBHOOK_SECRET: the output of stripe listen --print-secret (Stripe CLI).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Only needed to run ngrok in Docker (docker compose --profile tunnel up): dashboard.ngrok.com > Your Authtoken
# NGROK_AUTHTOKEN=

# true = only echo caller audio back (tests the stream without the AI services)
ECHO=false

# Claude (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Deepgram speech-to-text (console.deepgram.com)
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# multi hears English and Spanish, switching freely; set to en for English only
# DEEPGRAM_LANGUAGE=multi

# Cartesia text-to-speech (play.cartesia.ai). Pick a voice in the voice library and copy its ID.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Optional different voice for Spanish replies; otherwise CARTESIA_VOICE_ID speaks both
# CARTESIA_VOICE_ID_ES=
# CARTESIA_MODEL=sonic-latest

# true = Twilio records each call (check audio quality in the Twilio console)
RECORD_CALLS=false

# The demo business's owner alert numbers. Each business's numbers are stored in the database;
# these are only read by npm run db:seed, to fill in the demo business (Sunrise Dental).
# Owner's mobile: every message the receptionist takes is texted here (leave empty to disable)
# On a Twilio trial account this must be a Verified Caller ID.
OWNER_SMS_NUMBER=
# Owner's WhatsApp number: messages are also sent here (leave empty to disable)
OWNER_WHATSAPP_NUMBER=
# Your Twilio WhatsApp sender; defaults to the Twilio Sandbox number (+14155238886) for testing
# TWILIO_WHATSAPP_FROM=

# Demo business: number calls are transferred to when the caller asks for a person (leave empty
# to disable). Also only read by npm run db:seed.
TRANSFER_NUMBER=

# Cost summary printed after each call. Deepgram's billed minutes are fetched from its API
# (the project is found from the API key unless set here) and priced at this rate.
#DEEPGRAM_PROJECT_ID=
#DEEPGRAM_PRICE_PER_MIN=0.0077
