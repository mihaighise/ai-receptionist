PORT=3000
# Public https URL Twilio can reach (e.g. your ngrok URL), no trailing slash
PUBLIC_URL=https://waffle-yoga-golf.ngrok-free.dev

# Twilio console > Account Info. The auth token also enables webhook signature validation;
# the account SID is needed to transfer and hang up calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# true = only echo caller audio back (tests the stream without the AI services)
ECHO=false

# Claude (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Deepgram speech-to-text (console.deepgram.com)
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# multi hears English and Spanish, switching freely; set to en for English only
# DEEPGRAM_LANGUAGE=multi

# Cartesia text-to-speech (play.cartesia.ai). Pick a voice in the voice library and copy its ID.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Optional different voice for Spanish replies; otherwise CARTESIA_VOICE_ID speaks both
# CARTESIA_VOICE_ID_ES=
# CARTESIA_MODEL=sonic-latest

# true = Twilio records each call (check audio quality in the Twilio console)
RECORD_CALLS=false

# Owner's mobile: every message the receptionist takes is texted here (leave empty to disable)
# On a Twilio trial account this must be a Verified Caller ID.
OWNER_SMS_NUMBER=
# Owner's WhatsApp number: messages are also sent here (leave empty to disable)
OWNER_WHATSAPP_NUMBER=
# Your Twilio WhatsApp sender; defaults to the Twilio Sandbox number (+14155238886) for testing
# TWILIO_WHATSAPP_FROM=

# Number calls are transferred to when the caller asks for a person (leave empty to disable)
TRANSFER_NUMBER=

# Cost summary printed after each call. Deepgram's billed minutes are fetched from its API
# (the project is found from the API key unless set here) and priced at this rate.
#DEEPGRAM_PROJECT_ID=
#DEEPGRAM_PRICE_PER_MIN=0.0077
