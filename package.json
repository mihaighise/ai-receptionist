{
  "name": "ai-receptionist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/phone/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/phone/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/phone/server.js",
    "api": "node --env-file-if-exists=.env src/api/server.js",
    "api:dev": "node --watch --env-file-if-exists=.env src/api/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/shared/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/shared/db/seed.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "twilio": "^6.2.0",
    "ws": "^8.22.0"
  }
}
